{
  "name": "personal-knowledge-hub",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": "^24.7.0" },
  "scripts": {
    "openapi:export": "pnpm --filter @knowledge-hub/api build && node scripts/export-openapi.mjs",
    "test:e2e": "pnpm --filter @knowledge-hub/api build && pnpm --filter @knowledge-hub/web test:e2e",
    "dev": "pnpm --parallel --filter './apps/*' run dev",
    "lint": "oxlint --deny correctness apps/api/src apps/web/src",
    "typecheck": "pnpm -r run typecheck",
    "test": "node --test scripts/*.test.mjs && pnpm --filter @knowledge-hub/api test",
    "test:integration": "sh scripts/test-postgres.sh && pnpm --filter @knowledge-hub/database test:integration && pnpm --filter @knowledge-hub/api test:integration",
    "build": "pnpm -r run build"
  },
  "devDependencies": {
    "oxlint": "1.91.0"
  }
}
