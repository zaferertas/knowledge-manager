{
  "name": "personal-knowledge-hub",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' run dev",
    "lint": "oxlint --deny correctness apps/api/src apps/web/src",
    "typecheck": "pnpm -r run typecheck",
    "test": "node --test scripts/*.test.mjs && pnpm --filter @knowledge-hub/api test",
    "test:integration": "sh scripts/test-postgres.sh",
    "build": "pnpm -r run build"
  },
  "devDependencies": {
    "oxlint": "1.91.0"
  }
}
